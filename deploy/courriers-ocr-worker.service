[Unit]
Description=Banque de courriers OCR — worker d'ingestion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=courriers
Group=courriers
EnvironmentFile=/etc/courriers-ocr/courriers-ocr.env
WorkingDirectory=/opt/courriers-ocr
ExecStart=/opt/courriers-ocr/.venv/bin/python -m courriers_ocr.worker
Restart=always
RestartSec=5
Nice=10
# Isolation raisonnable
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/courriers-ocr

[Install]
WantedBy=multi-user.target
