# Variables d'environnement lues par les deux services systemd.
# Copié vers /etc/courriers-ocr/courriers-ocr.env par install.sh.
# Toute clé du config.toml peut être surchargée ici (préfixe COURRIERS_).

COURRIERS_DATA_DIR=/var/lib/courriers-ocr
COURRIERS_OCR_LANGUAGES=fra
COURRIERS_HOST=0.0.0.0
COURRIERS_PORT=8080
COURRIERS_POLL_INTERVAL_SECONDS=10
COURRIERS_STABLE_CHECKS=2

# Optionnel : protéger l'API par un jeton (Authorization: Bearer <token> ou ?token=)
# COURRIERS_API_TOKEN=

# Optionnel : pointer vers un fichier de config TOML complet
# COURRIERS_CONFIG=/etc/courriers-ocr/config.toml
