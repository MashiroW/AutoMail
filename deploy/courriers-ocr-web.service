[Unit]
Description=Banque de courriers OCR — interface web / API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=courriers
Group=courriers
EnvironmentFile=/etc/courriers-ocr/courriers-ocr.env
WorkingDirectory=/opt/courriers-ocr
ExecStart=/opt/courriers-ocr/.venv/bin/uvicorn courriers_ocr.app:app --host ${COURRIERS_HOST} --port ${COURRIERS_PORT}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/courriers-ocr

[Install]
WantedBy=multi-user.target
